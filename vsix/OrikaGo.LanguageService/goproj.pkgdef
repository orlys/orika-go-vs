// Registers ".goproj" as its own project type, mirroring the pattern VS itself
// uses for ".msbuildproj" (Common7\IDE\CommonExtensions\Microsoft\Project\msbuildproj.pkgdef):
// a dedicated project-type GUID whose "Package" is the generic CPS package
// {3347BEE8-D7A1-4082-95E4-38A439553CC2}. CPS evaluates the project file with
// MSBuild, so Sdk="Orika.NET.Sdk/1.0.0" resolves normally and builds drive the
// Go toolchain.
//
// Why not append "goproj" to PossibleProjectExtensions of the C#/SDK factory
// ({9A19103F-...} or {FAE04EC0-...})? Pkgdef merge is value ASSIGNMENT with no
// ordering guarantee against VS's own pkgdefs — the in-box value ("csproj") can
// be merged after ours and silently drop the registration, which manifests as
// "The template specified cannot be found" when the New Project dialog tries to
// open a freshly created .goproj. A dedicated key has no competing writers.
[$RootKey$\Projects\{8A0FBF95-6C22-4C1E-A1F5-2E9E7B3B7A10}]
@="ProjectFactory"
"DisplayName"="Orika Go Project"
"DisplayProjectFileExtensions"="Go Project Files (*.goproj);*.goproj"
"Package"="{3347BEE8-D7A1-4082-95E4-38A439553CC2}"
"DefaultProjectExtension"="goproj"
"PossibleProjectExtensions"="goproj"
"Language(VsTemplate)"="Go"
"DisableAsynchronousSolutionLoad"=dword:00000000
"DisableAsynchronousProjectTreeLoad"=dword:00000001
"PrefetchFactory"="{3998970A-AEE1-4216-A54F-0A99D20A1FAB}"
"Capabilities"="HandlesOwnReload;OpenProjectFile;EnableOnDemandExcludedFolderLoading"

// Go (Delve) debug engine, hosted by the Visual Studio Debug Adapter Host
// (same mechanism VS itself uses for CMake debugging). "CLSID" is the FIXED
// DAH engine implementation {DAB324E9-...}; only the engine GUID is ours and
// must match GoDebugLaunchProvider.DelveEngineGuid. "Adapter" is deliberately
// ABSENT: dlv dap speaks TCP only (no stdio), so the launch provider starts
// "dlv dap --listen=127.0.0.1:0" itself and hands the port to the host via
// "$debugServer" in the launch options. Exceptions/SetNextStatement are off:
// delve's DAP implements neither VS-style exception filters nor goto.
[$RootKey$\AD7Metrics\Engine\{2A5D6E81-4C9B-45E2-B8F3-9D0C7A1E6F24}]
"CLSID"="{DAB324E9-7B35-454C-ACA8-F6BB0D5C8673}"
"AlwaysLoadLocal"=dword:00000001
"AddressBP"=dword:00000000
"CallStackBP"=dword:00000000
"Attach"=dword:00000000
"Exceptions"=dword:00000000
"SetNextStatement"=dword:00000000
"Name"="Go Debugger (Delve)"
"Language"="Go"
"SuppressModulesRequestOnAttach"=dword:00000001
