<?xml version="1.0" encoding="utf-8"?>
<!--
  Merge target for the compiled command table: Microsoft.VsSDK.targets only
  embeds the .cto produced from OrikaGoPackage.vsct when an EmbeddedResource
  with MergeWithCTO=true / ManifestResourceName=VSPackage exists (the merged
  result becomes OrikaGo.LanguageService.VSPackage.resources with a
  "Menus.ctmenu" entry - what ProvideMenuResource("Menus.ctmenu", 1) loads).
  Without this file the vsct compiles but never lands in the assembly and the
  command silently never appears.
-->
