<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <ProjectGuid>{D1F7A2C4-9B3E-4E5A-8F21-6C0D7E5B9A31}</ProjectGuid>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>OrikaGo.LanguageService</RootNamespace>
    <AssemblyName>OrikaGo.LanguageService</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <!-- true since OrikaGoPackage exists: VSSDK generates the package/menu/UI
         context registration pkgdef from its attributes. goproj.pkgdef (the
         hand-written project-type registration) ships alongside it. -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- Do not auto-deploy to the Experimental instance during command-line builds;
         installation is performed explicitly with VSIXInstaller.exe. -->
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AddModuleReferenceDialog.cs" />
    <Compile Include="GoContentTypeDefinitions.cs" />
    <Compile Include="GoDebugLaunchProvider.cs" />
    <Compile Include="GoImageMonikers.cs" />
    <Compile Include="GoLanguageClient.cs" />
    <Compile Include="GoProjectTreeIconProvider.cs" />
    <Compile Include="GoToolLocator.cs" />
    <Compile Include="OrikaGoPackage.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="OrikaGoPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <SubType>Designer</SubType>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="goproj.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Registers the custom Go image monikers with the VS image service. VS
         discovers *.imagemanifest files in installed extension directories
         automatically; no vsixmanifest <Asset> or pkgdef entry is needed. -->
    <Content Include="OrikaGoImages.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- WPF component resources (embedded into OrikaGo.LanguageService.g.resources
         by Microsoft.WinFX.targets) referenced from OrikaGoImages.imagemanifest via
         "/OrikaGo.LanguageService;Component/Resources/..." URIs. The image service
         cannot load loose PNG files, only component/pack resources. -->
    <Resource Include="Resources\GoProjectNode.16.png" />
    <Resource Include="Resources\GoProjectNode.32.png" />
    <Resource Include="Resources\GoFileNode.16.png" />
    <Resource Include="Resources\GoFileNode.32.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- CPS extensibility surface (IProjectTreePropertiesProvider, AppliesTo, Order,
         ProjectImageMoniker/ToProjectSystemType). 17.9.380 is the newest stable 17.x
         and resolves against the same dependency graph as Microsoft.VisualStudio.SDK
         17.14.40265 (NuGet unifies shared deps upward). ExcludeAssets=runtime keeps
         the CPS assemblies out of the VSIX payload - VS provides them at runtime. -->
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem.SDK" Version="17.9.380">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- NOTE: <Resource> items (the icon PNGs) are embedded as WPF component
       resources ($(AssemblyName).g.resources) by Microsoft.WinFX.targets, which
       Microsoft.NETFramework.CurrentVersion.targets already imports unconditionally
       for net472 - no explicit WinFX import is needed (adding one raises MSB4011). -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
