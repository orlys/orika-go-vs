<?xml version="1.0" encoding="utf-8"?>
<!--
  Orika.NET.Sdk / Sdk / Sdk.targets
  Imported AFTER the user's project body. Imports the full Microsoft.NET.Sdk
  target graph first, then overrides the compile/run/clean/test/publish surface
  so that every verb drives the Go toolchain instead of Roslyn.

  Note on the target graph: for a .goproj, Microsoft.NET.Sdk falls back to
  LanguageTargets = Microsoft.Common.targets, which references but does NOT
  define CoreCompile and CreateManifestResourceNames. Both are defined below
  (same class of override Microsoft.Build.NoTargets uses).
-->
<Project>

  <!-- <GoExec>: Exec + a Go diagnostic parser that re-emits file/line/column
       through Log.LogError's structured overload, so go build / vet / test
       errors are navigable from the Visual Studio Error List. -->
  <Import Project="$(MSBuildThisFileDirectory)GoDiagnostics.targets" />

  <PropertyGroup>
    <!-- Microsoft.NET.Sdk only defaults LanguageTargets for .cs/.vb/.fsproj, and it
         imports the value immediately, so a .goproj must set it before that import. -->
    <LanguageTargets Condition="'$(LanguageTargets)' == '' And '$(MSBuildProjectExtension)' != '.csproj' And '$(MSBuildProjectExtension)' != '.vbproj' And '$(MSBuildProjectExtension)' != '.fsproj'">$(MSBuildToolsPath)\Microsoft.Common.targets</LanguageTargets>

    <!-- THE import Visual Studio's project system means by "critical imports":
         Microsoft.Managed.DesignTime.targets supplies the design-time build targets
         CPS calls when opening a project. The managed language targets bring it in
         for .csproj/.vbproj/.fsproj; a .goproj has to inject it itself, otherwise the
         project builds fine from the CLI but fails to open in Visual Studio.
         (Same technique as Microsoft.Build.NoTargets.) -->
    <CustomBeforeMicrosoftCommonTargets Condition="'$(ManagedLanguageTargetsGotImported)' == '' And Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\Managed\Microsoft.Managed.DesignTime.targets')">$(CustomBeforeMicrosoftCommonTargets);$(MSBuildExtensionsPath)\Microsoft\VisualStudio\Managed\Microsoft.Managed.DesignTime.targets</CustomBeforeMicrosoftCommonTargets>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(CommonTargetsPath)' == ''" />

  <!-- Microsoft.Managed.targets carries tasks that Microsoft.Common.CurrentVersion.targets
       expects; the managed language targets normally import it. -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.Managed.targets" Condition="'$(MSBuildAssemblyVersion)' >= '16.0' And '$(ManagedLanguageTargetsGotImported)' != 'true'" />

  <!-- Microsoft.Managed.DesignTime.targets adds PackageReferences whenever
       RestoreProjectStyle is PackageReference (which this SDK sets to keep
       restore quiet). That capability is what lights up NuGet's UI - 管理
       NuGet 套件, the Packages node - and a Go module takes dependencies
       through go.mod (GoModuleReference), never NuGet, so it is removed
       here, AFTER the import that added it. Restore itself still runs;
       only the UI affordances go away. -->
  <ItemGroup>
    <ProjectCapability Remove="PackageReferences" />
    <!-- LaunchProfiles stays: the managed project system's F5 plumbing (its
         IVsDebuggableProjectCfg) lives in that subsystem - removing the
         capability makes Debug.Start unavailable outright (verified). The
         delve hookup rides the pipeline instead: the VSIX exports an
         IDebugProfileLaunchTargetsProvider (GoDebugLaunchProvider), which is
         the extension point that pipeline actually consults per profile. -->
  </ItemGroup>

  <!-- ======================================================================
       Static computed properties
       ====================================================================== -->
  <PropertyGroup>
    <_GoHostIsWindows>$([MSBuild]::IsOSPlatform('Windows'))</_GoHostIsWindows>

    <!-- Regular build: GOOS/GoArch may be set by the user; default is the host. -->
    <_GoBuildExeSuffix Condition="'$(GoOS)' == 'windows' Or ('$(GoOS)' == '' And '$(_GoHostIsWindows)' == 'true')">.exe</_GoBuildExeSuffix>
    <GoOutputPath Condition="'$(GoOutputPath)' == ''">$(TargetDir)$(AssemblyName)$(_GoBuildExeSuffix)</GoOutputPath>

    <!-- Marker written into obj/$(Configuration)/$(TargetFramework)/ so MSBuild
         incrementality has an output to compare against (Library builds produce
         no file at all; Exe builds additionally compare the exe itself). -->
    <_GoBuildStamp>$(IntermediateOutputPath)go.build.stamp</_GoBuildStamp>
    <_GoBuildOutputs>$(_GoBuildStamp)</_GoBuildOutputs>
    <_GoBuildOutputs Condition="'$(OutputType)' == 'Exe'">$(_GoBuildStamp);$(GoOutputPath)</_GoBuildOutputs>
  </PropertyGroup>

  <!-- Re-point the managed output identity at the Go executable. TargetFileName /
       TargetPath were computed from TargetExt=.dll during the import above, so they
       must be recomputed here. This is the glue that makes GetTargetPath (and any
       ProjectReference to a .goproj) return the real build product. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <TargetExt>$(_GoBuildExeSuffix)</TargetExt>
    <TargetFileName>$(AssemblyName)$(TargetExt)</TargetFileName>
    <TargetPath>$(TargetDir)$(TargetFileName)</TargetPath>
  </PropertyGroup>

  <!-- dotnet run: execute the Go binary directly from the project directory.
       All three must be overridden: Microsoft.NET.Sdk already defaulted
       RunCommand=dotnet / RunArguments=exec "…dll" during the import above. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <RunCommand>$(GoOutputPath)</RunCommand>
    <RunArguments>$(StartArguments)</RunArguments>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <!-- RID -> GOOS/GOARCH map for dotnet publish -r <rid>. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <_GoRidOS Condition="$(RuntimeIdentifier.StartsWith('win-'))">windows</_GoRidOS>
    <_GoRidOS Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</_GoRidOS>
    <_GoRidOS Condition="$(RuntimeIdentifier.StartsWith('osx-'))">darwin</_GoRidOS>
    <_GoRidArch Condition="$(RuntimeIdentifier.EndsWith('-x64'))">amd64</_GoRidArch>
    <_GoRidArch Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</_GoRidArch>
  </PropertyGroup>

  <!-- Inputs for incremental builds. Evaluated statically; go.mod/go.sum are only
       added when they exist so a missing go.sum does not force perpetual rebuilds. -->
  <ItemGroup>
    <_GoBuildInput Include="@(GoCompile)" />
    <_GoBuildInput Include="@(GoNativeCompile)" />
    <_GoBuildInput Include="@(GoBuildInput)" />
    <_GoBuildInput Include="go.mod" Condition="Exists('$(MSBuildProjectDirectory)/go.mod')" />
    <_GoBuildInput Include="go.sum" Condition="Exists('$(MSBuildProjectDirectory)/go.sum')" />
    <_GoBuildInput Include="$(MSBuildProjectFullPath)" />
  </ItemGroup>

  <!-- Workspace builds resolve imports into SIBLING modules whose sources are
       not in @(_GoBuildInput) (the globs above are project-local by design), so
       after editing a sibling library - or adding a replace directive to
       go.work - a timestamp comparison would skip GoBuild and silently reuse a
       stale binary. When a go.work governs this project, opt out of the
       up-to-date skip by listing an input that never exists: MSBuild treats a
       missing input as out-of-date, so go build always runs, and go's own
       build cache keeps the no-change case down to one cheap process launch.
       The probe mirrors GoEnsureWorkspace's: GOWORK wins, else the nearest
       go.work above the project.
       ponytail: blanket always-build under go.work; enumerate sibling module
       sources as real inputs if that process launch ever matters. -->
  <PropertyGroup>
    <_GoWorkStaticProbe Condition="'$(GOWORK)' != ''">$(GOWORK)</_GoWorkStaticProbe>
    <_GoWorkStaticProbe Condition="'$(GOWORK)' == ''">$([MSBuild]::GetPathOfFileAbove('go.work', '$(MSBuildProjectDirectory)'))</_GoWorkStaticProbe>
  </PropertyGroup>
  <ItemGroup>
    <_GoBuildInput Include="$(IntermediateOutputPath)go.workspace.always-out-of-date"
                   Condition="'$(_GoWorkStaticProbe)' != '' And '$(_GoWorkStaticProbe)' != 'off'" />
  </ItemGroup>

  <!-- ======================================================================
       Module bootstrap: go.mod existence + LangVersion -> go directive.
       The go directive is the real LangVersion semantic: the Go toolchain
       gates language features on it (e.g. generics need go >= 1.18).
       ====================================================================== -->
  <Target Name="GoEnsureMod" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- GoExec, not Exec: a failure here (e.g. a GoModuleName override that go
         still rejects) must surface as a structured GOMOD error, not as an
         MSB3073 pointing at this file inside the NuGet cache. -->
    <GoExec Command="go mod init &quot;$(GoModuleName)&quot;"
            Condition="!Exists('$(MSBuildProjectDirectory)/go.mod')"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            ErrorCode="GOMOD" />
    <!-- "go mod edit" rewrites go.mod even when nothing changes, which would make
         go.mod perpetually newer than the build stamp and defeat incremental
         builds - so only run it when the directive actually differs.
         GOTOOLCHAIN=local: editing go.mod must never require the toolchain the
         file currently demands, or downgrading LangVersion wedges when go.mod
         points at a Go newer than the one installed. -->
    <GoExec Command="go mod edit -go=$(LangVersion)"
            Condition="'$(LangVersion)' != '' And Exists('$(MSBuildProjectDirectory)/go.mod') And !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod')), '(?m)^go\s+$(LangVersion)\s*$'))"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="GOTOOLCHAIN=local"
            ErrorCode="GOMOD" />
  </Target>

  <!-- ======================================================================
       Module references: <GoModuleReference Include="module/path" Version="vX.Y.Z" />
       is the PackageReference of the Go world - each one is materialized with
       "go get module@version", which resolves the module, records it in go.mod
       and fills go.sum. Version omitted means latest.

       Idempotence follows the same rule as "go mod edit -go" above: "go get"
       rewrites go.mod/go.sum even when nothing changes, which would defeat the
       incremental build, so each reference only runs when go.mod does not
       already require that module (at that version, when one is pinned).
       Changing Version in the project therefore re-runs it; REMOVING a
       reference does not remove the require - that is "go mod tidy" territory.
       ====================================================================== -->
  <Target Name="GoRestoreModules"
          Condition="'$(DesignTimeBuild)' != 'true' And '@(GoModuleReference)' != ''"
          DependsOnTargets="GoEnsureMod">
    <GoExec Command="go get &quot;%(GoModuleReference.Identity)@%(GoModuleReference.Version)&quot;"
            Condition="'%(GoModuleReference.Version)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod')), '(?m)^[ \t]*(require[ \t]+)?$([System.Text.RegularExpressions.Regex]::Escape('%(GoModuleReference.Identity)'))[ \t]+$([System.Text.RegularExpressions.Regex]::Escape('%(GoModuleReference.Version)'))([ \t]|$)'))"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            ErrorCode="GOGET" />
    <GoExec Command="go get &quot;%(GoModuleReference.Identity)&quot;"
            Condition="'%(GoModuleReference.Version)' == '' And !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/go.mod')), '(?m)^[ \t]*(require[ \t]+)?$([System.Text.RegularExpressions.Regex]::Escape('%(GoModuleReference.Identity)'))[ \t]+v'))"
            WorkingDirectory="$(MSBuildProjectDirectory)"
            ErrorCode="GOGET" />
  </Target>

  <!-- ======================================================================
       Workspace bootstrap: go.work membership.

       GOWORK is inherited by every subdirectory, so a module created anywhere
       underneath a directory that already owns a go.work is INSIDE the
       workspace but is not a MEMBER of it until go.work's "use" block lists
       it - and the toolchain then refuses to build it outright:
         main module (x) does not contain package x/<newmodule>
       That is exactly what the New Project flow produces, so the module is
       registered here, right after it has been given a go.mod.

       Opt out per project with <GoEnsureWorkspaceMembership>false</...> (for a
       module that is deliberately kept out of the workspace).

       One go.work is shared by every module under it, so a parallel solution
       build (/m) runs this target in several processes at once against the SAME
       file. Read-decide-write must therefore be atomic across processes, which
       is what <GoWorkUse> below provides; see its comment for why.
       ====================================================================== -->

  <!-- <GoWorkUse>: "go work use <path>", serialized across processes.

       The race it closes: with N .goproj projects sharing one go.work, MSBuild's
       /m gives each project its own node process. Each independently reads
       go.work, sees its own module missing, and runs "go work use". "go work
       use" is read-modify-write on the whole file, so two of them overlapping
       produce a last-writer-wins result that silently drops the other module -
       or, if the reader catches the writer mid-flight, a truncated go.work.
       Neither is recoverable by a rebuild: the next build reads the damaged
       file and "fixes" only its own entry.

       The lock is a named system Mutex, i.e. a kernel object, because the
       contenders are separate processes (an in-process lock would not see them)
       and because the OS releases it if a build is killed mid-write. It is
       named after the go.work path so that builds of unrelated workspaces never
       queue behind each other.

       Membership is re-checked INSIDE the lock. That is the actual fix: the
       "module missing" observation that got us here was made before the lock,
       so by the time we own it a sibling may already have added us, and the
       correct action is then to do nothing.

       Inline task via RoslynCodeTaskFactory for the same reason GoExec is one
       (see GoDiagnostics.targets): it is the only factory that runs under both
       "dotnet build" and Visual Studio's MSBuild.exe, so the SDK still ships
       nothing but MSBuild logic. -->
  <UsingTask TaskName="GoWorkUse"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <!-- Full path of the go.work in effect (already resolved by "go env GOWORK"). -->
      <GoWorkFile ParameterType="System.String" Required="true" />
      <!-- Directory holding it; "go work use" is run from here so the recorded
           entry stays relative. -->
      <WorkspaceDirectory ParameterType="System.String" Required="true" />
      <!-- The argument for "go work use", relative to WorkspaceDirectory. -->
      <UsePath ParameterType="System.String" Required="true" />
      <!-- Regex proving membership; built in GoEnsureWorkspace so the pattern
           has exactly one definition. -->
      <UsePattern ParameterType="System.String" Required="true" />
      <LockTimeoutSeconds ParameterType="System.Int32" />
      <!-- True only when this invocation actually wrote to go.work. -->
      <Added ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs"><![CDATA[

Added = false;

string workFile = GoWorkFile;
try { workFile = Path.GetFullPath(GoWorkFile); }
catch (Exception) { }

// Scope the lock to this go.work. FNV-1a rather than a crypto hash: the name
// only has to be stable and well distributed - a collision would merely make
// two unrelated workspaces share one lock, which costs a little serialization
// and breaks nothing - and it needs no assembly reference beyond mscorlib,
// which keeps the inline task compiling identically under MSBuild.exe and
// "dotnet build". Windows paths are case-insensitive, so fold case there or the
// same file reached by two spellings would take two different locks.
string key = workFile;
if (Path.DirectorySeparatorChar == '\\') key = key.ToUpperInvariant();
ulong hash = 14695981039346656037UL;
for (int i = 0; i < key.Length; i++)
{
    hash ^= (ulong)key[i];
    hash *= 1099511628211UL;
}
string lockName = "OrikaGo.GoWork." + hash.ToString("x16", CultureInfo.InvariantCulture);

int timeoutSeconds = LockTimeoutSeconds > 0 ? LockTimeoutSeconds : 120;

// "Global\": the contenders can live in different logon sessions (a VS build
// and a CLI build, or a build service). Creating a Global kernel object needs
// SeCreateGlobalPrivilege, which a plain interactive account may not hold, so
// degrade to the session-local namespace, and finally to no lock at all -
// which is exactly the unsynchronized behaviour this task replaces, never
// worse.
Mutex mutex = null;
bool createdNew;
try { mutex = new Mutex(false, "Global\\" + lockName, out createdNew); }
catch (Exception) { mutex = null; }
if (mutex == null)
{
    try { mutex = new Mutex(false, "Local\\" + lockName, out createdNew); }
    catch (Exception) { mutex = null; }
}
if (mutex == null)
{
    Log.LogMessage(MessageImportance.Low,
        "Orika.NET.Sdk: no cross-process lock available for \"" + workFile + "\"; proceeding unsynchronized.");
}

bool held = false;
try
{
    if (mutex != null)
    {
        try
        {
            held = mutex.WaitOne(TimeSpan.FromSeconds(timeoutSeconds));
        }
        catch (AbandonedMutexException)
        {
            // A previous owner exited without releasing (build killed mid-write).
            // WaitOne still transferred ownership to us, so we DO hold it. The
            // in-lock re-read below is what makes the half-finished predecessor
            // harmless: we look at the file as it actually is now.
            held = true;
        }
        if (!held)
        {
            Log.LogMessage(MessageImportance.Normal,
                "Orika.NET.Sdk: timed out after " + timeoutSeconds.ToString(CultureInfo.InvariantCulture) +
                "s waiting for the \"" + workFile + "\" workspace lock; proceeding without it.");
        }
    }

    // Re-check membership under the lock. FileShare.ReadWrite|Delete: a sibling
    // may legitimately be rewriting go.work when the lock could not be taken,
    // and a sharing violation here must not fail the build.
    bool isMember = false;
    try
    {
        string text;
        using (FileStream fs = new FileStream(workFile, FileMode.Open, FileAccess.Read,
                                              FileShare.ReadWrite | FileShare.Delete))
        using (StreamReader reader = new StreamReader(fs, new UTF8Encoding(false), true))
        {
            text = reader.ReadToEnd();
        }
        isMember = Regex.IsMatch(text, UsePattern, RegexOptions.CultureInvariant);
    }
    catch (Exception ex)
    {
        // Unreadable go.work: fall through and let "go work use" decide. It
        // rewrites an existing entry in place rather than duplicating it, so a
        // false negative here is safe.
        Log.LogMessage(MessageImportance.Low,
            "Orika.NET.Sdk: could not test membership in \"" + workFile + "\" (" + ex.Message + "); running \"go work use\" anyway.");
    }

    if (isMember)
    {
        // Idempotent: leave go.work's mtime alone so it does not thrash the
        // incremental build of every module in the workspace.
        Log.LogMessage(MessageImportance.Low,
            "Orika.NET.Sdk: \"" + UsePath + "\" is already used by \"" + workFile + "\".");
    }
    else
    {
        ProcessStartInfo psi = new ProcessStartInfo();
        psi.FileName = "go";
        psi.Arguments = "work use \"" + UsePath + "\"";
        psi.WorkingDirectory = WorkspaceDirectory;
        psi.UseShellExecute = false;
        psi.CreateNoWindow = true;
        psi.RedirectStandardOutput = true;
        psi.RedirectStandardError = true;
        // Deliberately NOT GOTOOLCHAIN=local: "go work use" LOADS the added
        // module's go.mod, so a module whose go directive is newer than the
        // installed toolchain (a langVersion the templates offer) would fail
        // with "requires go >= X" and could never join the workspace. The
        // default (auto) downloads the required toolchain, same as GoBuild.

        StringBuilder output = new StringBuilder();
        int exit = -1;
        try
        {
            using (Process proc = new Process())
            {
                proc.StartInfo = psi;
                proc.OutputDataReceived += (sender, e) =>
                {
                    if (e.Data != null) { lock (output) { output.AppendLine(e.Data); } }
                };
                proc.ErrorDataReceived += (sender, e) =>
                {
                    if (e.Data != null) { lock (output) { output.AppendLine(e.Data); } }
                };
                proc.Start();
                proc.BeginOutputReadLine();
                proc.BeginErrorReadLine();
                proc.WaitForExit();
                exit = proc.ExitCode;
            }
        }
        catch (Exception ex)
        {
            Log.LogError("Orika.NET.Sdk: failed to run \"go work use " + UsePath + "\" in \"" +
                         WorkspaceDirectory + "\": " + ex.Message);
            return false;
        }

        string outText = output.ToString().TrimEnd();
        if (outText.Length > 0) Log.LogMessage(MessageImportance.Normal, outText);

        if (exit != 0)
        {
            Log.LogError("Orika.NET.Sdk: \"go work use " + UsePath + "\" in \"" + WorkspaceDirectory +
                         "\" exited with code " + exit.ToString(CultureInfo.InvariantCulture) +
                         (outText.Length > 0 ? ": " + outText : "."));
            return false;
        }

        Added = true;
    }
}
finally
{
    if (mutex != null)
    {
        if (held)
        {
            try { mutex.ReleaseMutex(); }
            catch (Exception) { }
        }
        mutex.Dispose();
    }
}

]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GoEnsureWorkspace"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(GoEnsureWorkspaceMembership)' != 'false'"
          DependsOnTargets="GoEnsureMod">

    <!-- Cheap and exact pre-guard, so the common "no workspace at all" case
         costs nothing. The go command resolves GOWORK from the environment
         variable when it is set - it cannot come from anywhere else, "go env
         -w GOWORK=..." answers "go: GOWORK cannot be modified" - and otherwise
         by walking up from the working directory looking for go.work. If
         neither yields anything there is definitively no workspace, so skip
         the process launch instead of paying for it on every build. -->
    <PropertyGroup>
      <_GoWorkProbe Condition="'$(GOWORK)' != ''">$(GOWORK)</_GoWorkProbe>
      <_GoWorkProbe Condition="'$(GOWORK)' == ''">$([MSBuild]::GetPathOfFileAbove('go.work', '$(MSBuildProjectDirectory)'))</_GoWorkProbe>
    </PropertyGroup>

    <!-- Authoritative value: let the toolchain itself say which go.work is in
         effect rather than trusting the reimplementation above. -->
    <Exec Condition="'$(_GoWorkProbe)' != '' And '$(_GoWorkProbe)' != 'off'"
          Command="go env GOWORK"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="GOTOOLCHAIN=local"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GoWorkFile" />
    </Exec>

    <PropertyGroup>
      <_GoWorkFile>$(_GoWorkFile.Trim())</_GoWorkFile>
      <_GoWorkFile Condition="'$(_GoWorkFile)' == 'off' Or !Exists('$(_GoWorkFile)')"></_GoWorkFile>
      <_GoWorkDir Condition="'$(_GoWorkFile)' != ''">$([System.IO.Path]::GetDirectoryName('$(_GoWorkFile)'))</_GoWorkDir>

      <!-- go.work spells its use paths relative to itself, with forward
           slashes. MakeRelative returns "." when the project dir IS the
           workspace dir, which is also how go.work spells that entry. -->
      <_GoWorkRel Condition="'$(_GoWorkDir)' != ''">$([MSBuild]::MakeRelative('$(_GoWorkDir)', '$(MSBuildProjectDirectory)').Replace('\', '/').TrimEnd('/'))</_GoWorkRel>
      <_GoWorkRel Condition="'$(_GoWorkDir)' != '' And '$(_GoWorkRel)' == ''">.</_GoWorkRel>

      <!-- Matches the entry in either shape go.work accepts - inside a "use (
           ... )" block or on a single "use <path>" line - with the optional
           "./" prefix and the quoting go adds for paths containing spaces.
           An absolute entry (what "go work use <absolute-path>" leaves behind,
           and what a hand-written go.work may contain) counts as membership
           too, so both slash flavours are accepted. Regex.Escape is what keeps
           a path such as "v1.2" from turning its dots into wildcards. -->
      <_GoWorkUsePattern Condition="'$(_GoWorkRel)' != ''">(?m)^[ \t]*(use[ \t]+)?"?((\./)?$([System.Text.RegularExpressions.Regex]::Escape('$(_GoWorkRel)'))|$([System.Text.RegularExpressions.Regex]::Escape('$(MSBuildProjectDirectory)'))|$([System.Text.RegularExpressions.Regex]::Escape('$(MSBuildProjectDirectory.Replace('\', '/'))')))"?[ \t]*$</_GoWorkUsePattern>
    </PropertyGroup>

    <!-- The membership test that used to live here - a Regex.IsMatch over
         File.ReadAllText - now runs inside GoWorkUse instead. It has to: a
         decision taken during evaluation is already stale by the time the write
         happens, which is precisely the race being fixed. Testing it twice would
         also open a second, unsynchronized read window onto a file a sibling
         build may be rewriting.

         The RELATIVE path is passed deliberately: "go work use" records the
         argument as given, so handing it an absolute path bakes a machine
         specific (and, on Windows, backslash-separated) entry into a file that
         is normally committed. Run from the workspace directory, the relative
         form lands as the canonical "./<path>" that go itself writes. -->
    <GoWorkUse Condition="'$(_GoWorkDir)' != '' And Exists('$(MSBuildProjectDirectory)/go.mod')"
               GoWorkFile="$(_GoWorkFile)"
               WorkspaceDirectory="$(_GoWorkDir)"
               UsePath="$(_GoWorkRel)"
               UsePattern="$(_GoWorkUsePattern)">
      <Output TaskParameter="Added" PropertyName="_GoWorkAdded" />
    </GoWorkUse>

    <Message Importance="normal"
             Condition="'$(_GoWorkAdded)' == 'true'"
             Text="$(MSBuildProjectName) -&gt; added &quot;$(_GoWorkRel)&quot; to $(_GoWorkFile)" />
  </Target>

  <!-- ======================================================================
       Shared argument/environment computation for build, vet and test.
       ====================================================================== -->
  <Target Name="GoPrepareBuildSettings">
    <ItemGroup>
      <!-- Item-splitting on $(DefineConstants) drops empty entries, so
           "FOO;;BAR;" still yields clean "-tags FOO,BAR". -->
      <_GoDefineConstant Include="$(DefineConstants)" />

      <_GoEnv Include="GOOS=$(GoOS)" Condition="'$(GoOS)' != ''" />
      <_GoEnv Include="GOARCH=$(GoArch)" Condition="'$(GoArch)' != ''" />
      <_GoEnv Include="GOTOOLCHAIN=$(GoToolchain)" Condition="'$(GoToolchain)' != ''" />
    </ItemGroup>
    <PropertyGroup>
      <_GoTags>@(_GoDefineConstant, ',')</_GoTags>
      <!-- Escaped semicolons (%3B on the command line) survive item splitting;
           normalize them to commas as well. -->
      <_GoTags>$(_GoTags.Replace(';', ','))</_GoTags>

      <_GoBuildArgs Condition="'$(Configuration)' == 'Release'">-trimpath -ldflags "-s -w"</_GoBuildArgs>
      <_GoBuildArgs Condition="'$(Configuration)' == 'Debug'">-gcflags "all=-N -l"</_GoBuildArgs>
      <_GoBuildArgs Condition="'$(_GoTags)' != ''">$(_GoBuildArgs) -tags "$(_GoTags)"</_GoBuildArgs>
      <_GoBuildArgs Condition="'$(GoFlags)' != ''">$(_GoBuildArgs) $(GoFlags)</_GoBuildArgs>
    </PropertyGroup>

    <!-- Persist the effective arguments/environment so flag-only changes
         (e.g. a different DefineConstants -> -tags) invalidate GoBuild's
         up-to-date check; without this a stale binary is silently reused. -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)go.build.args"
                      Lines="$(_GoBuildArgs);@(_GoEnv)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Persist the input SET as well. Inputs/Outputs only compare timestamps of
         files that still exist, so DELETING a source file would otherwise leave a
         stale binary: the file vanishes from Inputs and nothing looks out of date.
         Rewriting this list on any set change makes it newer than the output. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)go.build.inputs"
                      Lines="@(_GoBuildInput->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <_GoBuildInput Include="$(IntermediateOutputPath)go.build.args" />
      <_GoBuildInput Include="$(IntermediateOutputPath)go.build.inputs" />
    </ItemGroup>
  </Target>

  <!-- ======================================================================
       Build
       ====================================================================== -->
  <Target Name="GoBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="GoEnsureMod;GoEnsureWorkspace;GoRestoreModules;GoPrepareBuildSettings"
          Inputs="@(_GoBuildInput)"
          Outputs="$(_GoBuildOutputs)">
    <MakeDir Directories="$(TargetDir);$(IntermediateOutputPath)" />

    <!-- GoExec, not Exec: the compiler's "file:line:col: message" lines are
         re-logged with real file/line/column so they are navigable from the
         Error List. See GoDiagnostics.targets. -->
    <GoExec Condition="'$(OutputType)' == 'Exe'"
            Command="go build $(_GoBuildArgs) -o &quot;$(GoOutputPath)&quot; ."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="@(_GoEnv)"
            ErrorCode="GOBUILD" />

    <!-- Library: compile-check the whole module, no artifact. -->
    <GoExec Condition="'$(OutputType)' != 'Exe'"
            Command="go build $(_GoBuildArgs) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="@(_GoEnv)"
            ErrorCode="GOBUILD" />

    <Touch Files="$(_GoBuildStamp)" AlwaysCreate="true" />
    <Message Importance="High" Text="$(MSBuildProjectName) -&gt; $(GoOutputPath)" Condition="'$(OutputType)' == 'Exe'" />
  </Target>

  <!-- CoreCompile is referenced by Microsoft.Common's CompileDependsOn but (like
       CreateManifestResourceNames) is normally defined by language targets that a
       .goproj never imports. Defining them here both completes the target graph
       and guarantees Roslyn never runs. -->
  <Target Name="CoreCompile" DependsOnTargets="GoBuild" />
  <Target Name="CreateManifestResourceNames" />

  <!-- Optional lint pass: dotnet build -p:RunGoVet=true -->
  <Target Name="GoVet"
          AfterTargets="GoBuild"
          Condition="'$(RunGoVet)' == 'true' And '$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="GoPrepareBuildSettings">
    <!-- $(_GoBuildArgs) rides along ("go vet" accepts build flags): vet must see
         the same build context - tags, GoFlags - that GoBuild just compiled, or
         it analyses a different file set than the one that was built. -->
    <GoExec Command="go vet $(_GoBuildArgs) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="@(_GoEnv)"
            ErrorCode="GOVET" />
  </Target>

  <!-- ======================================================================
       Clean. The Go outputs are deliberately not recorded in @(FileWrites)
       (a skipped-up-to-date GoBuild would leave them out of the current list
       and IncrementalClean would delete a perfectly good binary), so they are
       removed explicitly here. Both suffixed and suffixless names are deleted
       to cover cross-OS GoOS builds.
       ====================================================================== -->
  <Target Name="GoClean" AfterTargets="CoreClean">
    <!-- $(GoOutputPath) is listed explicitly: a project that overrides it writes
         outside $(TargetDir), and clean must still remove what build produced. -->
    <Delete Files="$(GoOutputPath);$(TargetDir)$(AssemblyName).exe;$(TargetDir)$(AssemblyName);$(_GoBuildStamp)" />
  </Target>

  <!-- ======================================================================
       Test: dotnet test => go test ./... ; a non-zero exit code from Exec
       fails the target, which fails dotnet test. Overrides/supplies the VSTest
       entry point the CLI invokes.
       ====================================================================== -->
  <Target Name="VSTest" DependsOnTargets="GoEnsureMod;GoEnsureWorkspace;GoRestoreModules;GoPrepareBuildSettings">
    <!-- $(_GoBuildArgs) rides along ("go test" accepts build flags): the test
         binary must be compiled with the same tags/GoFlags as the build, or
         DefineConstants-gated code is tested against the wrong file set. -->
    <GoExec Command="go test $(_GoBuildArgs) $(GoTestFlags) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="@(_GoEnv)"
            ErrorCode="GOTEST" />
  </Target>

  <!-- ======================================================================
       Publish: dotnet publish [-r <rid>] => cross-compiled Go binary in
       $(PublishDir) (bin/$(Configuration)/$(TargetFramework)/<rid>/publish/).
       This replaces Microsoft.NET.Publish.targets' Publish target entirely -
       there is no managed payload to lay out, and depending on Build would
       only produce a host-OS binary that publish does not use.
       ====================================================================== -->
  <!-- Explicit GoOS/GoArch fill the gap for RIDs outside the built-in map
       (e.g. -r freebsd-x64 -p:GoOS=freebsd -p:GoArch=amd64), so the error only
       fires when the effective value would end up empty. -->
  <Target Name="_GoValidatePublishRid" Condition="'$(RuntimeIdentifier)' != ''">
    <Error Condition="('$(_GoRidOS)' == '' And '$(GoOS)' == '') Or ('$(_GoRidArch)' == '' And '$(GoArch)' == '')"
           Text="Orika.NET.Sdk: RuntimeIdentifier '$(RuntimeIdentifier)' has no GOOS/GOARCH mapping. Supported RIDs: win-x64, win-arm64, linux-x64, linux-arm64, osx-x64, osx-arm64 - or set GoOS/GoArch explicitly." />
  </Target>

  <Target Name="_GoPreparePublishSettings" DependsOnTargets="GoPrepareBuildSettings">
    <PropertyGroup>
      <!-- Explicit GoOS/GoArch win over the RID map; default is the host. -->
      <_GoPublishOS>$(GoOS)</_GoPublishOS>
      <_GoPublishOS Condition="'$(_GoPublishOS)' == ''">$(_GoRidOS)</_GoPublishOS>
      <_GoPublishArch>$(GoArch)</_GoPublishArch>
      <_GoPublishArch Condition="'$(_GoPublishArch)' == ''">$(_GoRidArch)</_GoPublishArch>

      <!-- .exe suffix only when the effective GOOS is windows. -->
      <_GoPublishExeSuffix Condition="'$(_GoPublishOS)' == 'windows' Or ('$(_GoPublishOS)' == '' And '$(_GoHostIsWindows)' == 'true')">.exe</_GoPublishExeSuffix>
      <GoPublishOutputPath Condition="'$(GoPublishOutputPath)' == ''">$(PublishDir)$(AssemblyName)$(_GoPublishExeSuffix)</GoPublishOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <_GoPublishEnv Include="GOOS=$(_GoPublishOS)" Condition="'$(_GoPublishOS)' != ''" />
      <_GoPublishEnv Include="GOARCH=$(_GoPublishArch)" Condition="'$(_GoPublishArch)' != ''" />
      <_GoPublishEnv Include="GOTOOLCHAIN=$(GoToolchain)" Condition="'$(GoToolchain)' != ''" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <GoPublishDependsOn>_GoValidatePublishRid;GoEnsureMod;GoEnsureWorkspace;GoRestoreModules;_GoPreparePublishSettings</GoPublishDependsOn>
  </PropertyGroup>

  <Target Name="Publish"
          Condition="'$(IsPublishable)' == 'true'"
          DependsOnTargets="$(GoPublishDependsOn)">
    <MakeDir Directories="$(PublishDir)" />

    <GoExec Condition="'$(OutputType)' == 'Exe'"
            Command="go build $(_GoBuildArgs) -o &quot;$(GoPublishOutputPath)&quot; ."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="@(_GoPublishEnv)"
            ErrorCode="GOBUILD" />

    <GoExec Condition="'$(OutputType)' != 'Exe'"
            Command="go build $(_GoBuildArgs) ./..."
            WorkingDirectory="$(MSBuildProjectDirectory)"
            EnvironmentVariables="@(_GoPublishEnv)"
            ErrorCode="GOBUILD" />

    <Message Importance="High" Text="$(MSBuildProjectName) -&gt; $([System.IO.Path]::GetFullPath('$(PublishDir)'))" />
  </Target>

</Project>
